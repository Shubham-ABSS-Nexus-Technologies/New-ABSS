# ========================================================
# ABSS Nexus Technologies - Environment Configuration
# ========================================================

# --------------------------------------------------------
# Admin Authentication (Required in Production)
# --------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-to-a-strong-secure-password
AUTH_SECRET=generate-a-64-character-random-hex-or-base64-secret

# --------------------------------------------------------
# Cloudflare Turnstile (Optional Bot Protection)
# --------------------------------------------------------
# Obtain these from Cloudflare Dashboard -> Turnstile
# Client-side Site Key (Public):
# TURNSTILE_SITE_KEY=0x4AAAAAAxxxxxxxxxxxxxxxx
# Server-side Secret Key:
# TURNSTILE_SECRET_KEY=0x4AAAAAAxxxxxxxxxxxxxxxx

# --------------------------------------------------------
# Local Development Server (Optional)
# --------------------------------------------------------
PORT=3000
